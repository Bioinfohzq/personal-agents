# 默认模型（API 模型名，见 model_config.MODELS）
DEFAULT_MODEL=deepseek-v4-pro

# DeepSeek
DEEPSEEK_API_KEY=your-deepseek-api-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Kimi (Moonshot)
MOONSHOT_API_KEY=your-moonshot-api-key
# MOONSHOT_BASE_URL=https://api.moonshot.cn/v1

# 其他提供商（按需启用）
# OPENAI_API_KEY=
# ZHIPU_API_KEY=
# ZHIPU_BASE_URL=
# DOUBAO_API_KEY=
# DOUBAO_BASE_URL=

# Checkpoint / 短期记忆后端
# 可选：memory | sqlite | postgres | mongodb
CHECKPOINT_BACKEND=sqlite

# SQLite 文件路径（CHECKPOINT_BACKEND=sqlite 时生效）
CHECKPOINT_SQLITE_PATH=./.langgraph_api/checkpoints.sqlite

# PostgreSQL 连接串（CHECKPOINT_BACKEND=postgres 时生效）
# CHECKPOINT_POSTGRES_URI=postgresql://user:pass@localhost:5432/langgraph

# MongoDB 连接串（CHECKPOINT_BACKEND=mongodb 时生效）
# CHECKPOINT_MONGODB_URI=mongodb://localhost:27017/langgraph?replicaSet=rs0

# Aurixm Android IPC 配置
# USB 模式：先执行 adb forward tcp:<port> tcp:<port>，host 填 127.0.0.1
# WiFi 模式：手机和电脑同一局域网，host 填手机 IP，不需要 adb forward
AURIXM_IPC_HOST=127.0.0.1
AURIXM_IPC_PORT=8080
AURIXM_IPC_TOKEN=
